                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e23" edge="1" parent="1" source="B10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="R7">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e24" edge="1" parent="1" source="R7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="B11">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="modelCard" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#666666;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Model family&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GRFNet&lt;/b&gt; (A1&amp;ndash;A4)&lt;ul style=&quot;margin:2px 0 8px 0;padding-left:16px&quot;&gt;&lt;li&gt;Stateless: one prediction per input&lt;/li&gt;&lt;li&gt;Learnable spatial filters, optionally seeded from sensor positions&lt;/li&gt;&lt;li&gt;Frozen ROCKET-style dilated kernel bank plus learnable kernels&lt;/li&gt;&lt;li&gt;PPV, log-variance and mean pooling fused by a learned gate&lt;/li&gt;&lt;li&gt;Linear, custom or no head; any input length&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;FastGRFNet&lt;/b&gt; (B5&amp;ndash;B6)&lt;ul style=&quot;margin:2px 0 8px 0;padding-left:16px&quot;&gt;&lt;li&gt;Fast-weight spatial layer rewritten by a delta rule after each trial&lt;/li&gt;&lt;li&gt;Explicit state, reset at the start of each subject&lt;/li&gt;&lt;li&gt;Write modes: off, unsupervised, label_feedback&lt;/li&gt;&lt;li&gt;With writes off, outputs match GRFNet&lt;/li&gt;&lt;li&gt;Meta-trained on subject episodes&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;GRFNetSeq&lt;/b&gt; (B7)&lt;ul style=&quot;margin:2px 0 8px 0;padding-left:16px&quot;&gt;&lt;li&gt;Causal convolutions that only look back in time&lt;/li&gt;&lt;li&gt;A prediction at every time step&lt;/li&gt;&lt;li&gt;Streams input in chunks, carrying state between them&lt;/li&gt;&lt;li&gt;For continuous decoding and event onset detection&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;GRFNet2d&lt;/b&gt; (B8)&lt;ul style=&quot;margin:2px 0 8px 0;padding-left:16px&quot;&gt;&lt;li&gt;The same design with 2-D and 3-D kernel banks&lt;/li&gt;&lt;li&gt;Inputs are images or volumes&lt;/li&gt;&lt;li&gt;On EEGMMIDB: spectrograms, with electrodes as image channels&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;GRFRidge&lt;/b&gt; (B9)&lt;ul style=&quot;margin:2px 0 8px 0;padding-left:16px&quot;&gt;&lt;li&gt;Frozen GRF features with a closed-form ridge classifier&lt;/li&gt;&lt;li&gt;No backpropagation&lt;/li&gt;&lt;li&gt;scikit-learn fit and predict API&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Reference baselines&lt;/b&gt; (B4)&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;EEGNet and ShallowConvNet from braindecode, for comparison only&lt;/li&gt;&lt;/ul&gt;" vertex="1">
                    <mxGeometry height="760" width="380" x="790" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
